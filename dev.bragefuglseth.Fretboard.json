{
    "app-id" : "dev.bragefuglseth.Fretboard",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command" : "fretboard",
    "finish-args" : [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin"
    },
    "modules" : [
        {
            "name" : "fretboard",
            "builddir" : true,
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dprofile=default",
                "-Dsandboxed=true"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/bragefuglseth/fretboard.git",
                    "tag" : "v9.1",
                    "commit" : "d2415a4321ee0e6c3bc50c40b71433c01be5357b"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
